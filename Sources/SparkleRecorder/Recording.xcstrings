{
  "sourceLanguage": "en",
  "strings": {
    "Target windows": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Target windows" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "目标窗口" } }
      }
    },
    "No target window is set.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No target window is set." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未设置目标窗口。" } }
      }
    },
    "No target window is set. Playback uses the recorded screen coordinates until an action is explicitly bound to a Playback Surface.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No target window is set. Playback uses the recorded screen coordinates until an action is explicitly bound to a Playback Surface." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未设置目标窗口。只有动作明确绑定到某个播放窗口后，回放才会使用该窗口；否则使用录制时的屏幕坐标。" } }
      }
    },
    "Action recording": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作录制中"
          }
        }
      }
    },
    "As SparkleRecorder File…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As SparkleRecorder File…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SparkleRecorder 文件…"
          }
        }
      }
    },
    "Capture anything": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture anything"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录常用操作"
          }
        }
      }
    },
    "Click anywhere on the screen to pick coordinate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click anywhere on the screen to pick coordinate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在屏幕任意位置点击以选取坐标"
          }
        }
      }
    },
    "Click the menu-bar icon or this Dock icon to open the library. Press Record to capture your first macro — SparkleRecorder will count down %d seconds before it starts so you have time to switch to the right window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the menu-bar icon or this Dock icon to open the library. Press Record to capture your first macro — SparkleRecorder will count down %d seconds before it starts so you have time to switch to the right window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏图标或 Dock 图标打开宏库。点按“录制”捕获第一个宏。开始前会倒计时 %d 秒，方便你切到目标窗口。"
          }
        }
      }
    },
    "Click the menu-bar icon or this Dock icon to open the library. Press Record to capture your first macro — recording starts immediately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the menu-bar icon or this Dock icon to open the library. Press Record to capture your first macro — recording starts immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏图标或 Dock 图标打开宏库。点按“录制”即可捕获第一个宏，录制会立即开始。"
          }
        }
      }
    },
    "Click to Record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to Record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击录入"
          }
        }
      }
    },
    "Click to record shortcut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to record shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击录入快捷键"
          }
        }
      }
    },
    "Drag to capture baseline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to capture baseline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以捕获基准图"
          }
        }
      }
    },
    "Edits the captured key and modifiers while keeping the action timing in place.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits the captured key and modifiers while keeping the action timing in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑捕获的按键和修饰键，同时保留该动作的时间位置。"
          }
        }
      }
    },
    "Grant Accessibility & Input Monitoring to record and replay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility & Input Monitoring to record and replay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予“辅助功能”和“输入监控”权限后即可录制和回放。"
          }
        }
      }
    },
    "Screen Recording is required while visual evidence is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording is required while visual evidence is enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用视觉证据时，需要授予“屏幕录制”权限。"
          }
        }
      }
    },
    "Optional. Required only for visual evidence and OCR.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Required only for visual evidence and OCR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。只有使用视觉证据和 OCR 时才需要。"
          }
        }
      }
    },
    "Menu bar only hides the Dock icon — open SparkleRecorder from the menu-bar icon.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar only hides the Dock icon — open SparkleRecorder from the menu-bar icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 Dock 图标后，可从菜单栏图标打开 SparkleRecorder。"
          }
        }
      }
    },
    "Menu bar only hides the Dock icon. Use the menu-bar icon to reopen SparkleRecorder.": {
      "extractionState": "manual",
