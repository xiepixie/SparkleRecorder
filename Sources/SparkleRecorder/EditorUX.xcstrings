    },
    "AI can analyze actions, but this recording has no screen frames.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI can analyze actions, but this recording has no screen frames." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "AI 可以分析动作序列，但这次录制没有保存屏幕画面帧。" } }
      }
    },
    "The linked visual evidence is unavailable. AI can analyze actions, but it must not infer the recorded screen state.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The linked visual evidence is unavailable. AI can analyze actions, but it must not infer the recorded screen state." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已关联的视觉证据当前不可用。AI 可以分析动作，但不能据此推断录制时的屏幕状态。" } }
      }
    },
    "Visual evidence is ready. Include it to give AI the recording plus an action-linked map for seeking, cropping, and checking coordinates.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Visual evidence is ready. Include it to give AI the recording plus an action-linked map for seeking, cropping, and checking coordinates." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "视觉证据已就绪。导出后，AI 可结合录制画面与动作关联的定位图，按时间跳转、裁剪放大并核对坐标。" } }
      }
    },
