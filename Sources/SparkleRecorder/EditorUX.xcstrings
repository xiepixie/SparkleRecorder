    "Use for selection": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use for selection" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于所选动作" } }
      }
    },
    "Reassign every action that uses this surface before removing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reassign every action that uses this surface before removing it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "移除此窗口前，请先为所有引用它的动作重新指定播放窗口。" } }
      }
    },
    "The current selection spans multiple Playback Surfaces. Rebind each surface independently, or choose one surface explicitly for the selected actions.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current selection spans multiple Playback Surfaces. Rebind each surface independently, or choose one surface explicitly for the selected actions." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前所选动作跨越多个播放窗口。请分别重新绑定各窗口，或明确为所选动作指定同一个播放窗口。" } }
      }
    },
    "Add Target Window…": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add Target Window…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "添加目标窗口…" } }
      }
    },
    "Change Playback Surface": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Change Playback Surface" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "更改播放窗口" } }
      }
    },
    "The Playback Surface changed before it could be updated. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The Playback Surface changed before it could be updated. Try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "播放窗口在更新前已发生变化，请重试。" } }
      }
    },
    "Reassign every action that uses this Playback Surface before removing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reassign every action that uses this Playback Surface before removing it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "移除此播放窗口前，请先为所有引用它的动作重新指定窗口。" } }
      }
    },
    "This macro uses multiple Playback Surfaces. Open the editor to manage them individually.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This macro uses multiple Playback Surfaces. Open the editor to manage them individually." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此宏使用多个播放窗口。请打开编辑器分别管理这些窗口。" } }
      }
    },
    "This reconstruction package uses an unsupported contract manifest (%@). Export the current macro again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This reconstruction package uses an unsupported contract manifest (%@). Export the current macro again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此重建包使用了不受支持的契约清单（%@）。请重新导出当前宏。" } }
      }
    },
    "This reconstruction package uses an unsupported source-context contract (%@). Export the current macro again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This reconstruction package uses an unsupported source-context contract (%@). Export the current macro again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此重建包使用了不受支持的源上下文契约（%@）。请重新导出当前宏。" } }
      }
    },
    "This reconstruction package uses an unsupported action-context contract (%@). Export the current macro again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This reconstruction package uses an unsupported action-context contract (%@). Export the current macro again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此重建包使用了不受支持的动作上下文契约（%@）。请重新导出当前宏。" } }
      }
    },
    "Reconstruction package contract metadata disagrees for %@. Export the current macro again instead of mixing package files.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reconstruction package contract metadata disagrees for %@. Export the current macro again instead of mixing package files." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重建包中的 %@ 契约信息不一致。请重新导出当前宏，不要混用不同重建包中的文件。" } }
      }
    },
    "Actions only": {
      "extractionState": "manual",
