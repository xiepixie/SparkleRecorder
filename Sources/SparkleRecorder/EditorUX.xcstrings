{
  "sourceLanguage": "en",
  "strings": {
    "Assign the selected action to one Playback Surface before retargeting its coordinates.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Assign the selected action to one Playback Surface before retargeting its coordinates." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重新定位坐标前，请先为所选动作明确指定一个播放窗口。" } }
      }
    },
    "Choose one Playback Surface for the selected text actions before picking text.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose one Playback Surface for the selected text actions before picking text." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "拾取文本前，请先为所选文本动作明确指定同一个播放窗口。" } }
      }
    },
    "%d referenced events": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%d referenced events" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 个事件引用" } }
      }
    },
    "The current selection uses this Playback Surface.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current selection uses this Playback Surface." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前所选动作使用此播放窗口。" } }
      }
    },
    "Rebind…": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Rebind…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重新绑定…" } }
