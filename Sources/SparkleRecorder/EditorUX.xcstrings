    "Recording aligned": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Recording aligned" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已与原始录制对齐" } }
      }
    },
    "Recording alignment unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Recording alignment unavailable" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法与原始录制对齐" } }
      }
    },
    "This macro changed after recording, but no verified source revision is available to realign it. Action times below are not video seek times.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This macro changed after recording, but no verified source revision is available to realign it. Action times below are not video seek times." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此宏在录制后已被修改，但当前没有可验证的源版本可用于重新对齐。下方动作时间不能用于定位视频。" } }
      }
    },
    "Some edited steps cannot be aligned to the original video. Verified steps can still seek precisely.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some edited steps cannot be aligned to the original video. Verified steps can still seek precisely." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分已编辑步骤无法与原始视频精确对齐；已验证的步骤仍可准确定位视频。" } }
      }
    },
    "Standalone candidate": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Standalone candidate" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "独立候选版本" } }
