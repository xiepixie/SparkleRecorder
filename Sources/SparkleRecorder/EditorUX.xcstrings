    "Visual evidence included": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Visual evidence included" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "包含视觉证据" } }
