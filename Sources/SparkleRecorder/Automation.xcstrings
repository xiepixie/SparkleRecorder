    "Evidence includes reports, ending screenshots, condition evidence, and other run files. When evidence expires, the run result stays in history until its history retention period ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence includes reports, ending screenshots, condition evidence, and other run files. When evidence expires, the run result stays in history until its history retention period ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证据包括运行报告、结束截图、条件证据和其他运行文件。证据到期清理后，运行结果仍会保留在历史中，直到运行历史的保留期结束。"
          }
        }
      }
    },
    "Automatic cleanup keeps active runs, the latest execution for each workflow, the latest run needing attention, and the latest evidence for each macro.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic cleanup keeps active runs, the latest execution for each workflow, the latest run needing attention, and the latest evidence for each macro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动清理会保留正在运行的任务、每个工作流最近一次执行、最近一次需要处理的运行，以及每个宏的最新证据。"
          }
        }
      }
    },
    "Run history targets at most 10,000 records. Protected or active runs may temporarily exceed this limit. Choosing Never disables only the age limit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run history targets at most 10,000 records. Protected or active runs may temporarily exceed this limit. Choosing Never disables only the age limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行历史以最多 10,000 条记录为目标；受保护或正在运行的记录可能暂时超过该上限。选择“永不”只会停用按时间清理。"
          }
        }
      }
    },
    "Clean up run history?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up run history?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理运行历史？"
          }
        }
      }
    },
    "This will remove evidence from %d run(s), delete %d old history record(s), and free about %@. Protected recent runs will stay available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove evidence from %1$d run(s), delete %2$d old history record(s), and free about %3$@. Protected recent runs will stay available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将清理 %1$d 次运行的证据、删除 %2$d 条旧历史记录，预计释放 %3$@。受保护的近期运行仍会保留。"
          }
        }
      }
    },
    "This will mark expired evidence from %d run(s) as cleaned and delete %d old history record(s). No local evidence files are currently taking space. Protected recent runs will stay available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will mark expired evidence from %1$d run(s) as cleaned and delete %2$d old history record(s). No local evidence files are currently taking space. Protected recent runs will stay available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把 %1$d 次运行的过期证据标记为已清理，并删除 %2$d 条旧历史记录。当前没有这些证据对应的本地文件占用空间；受保护的近期运行仍会保留。"
          }
        }
      }
    },
    "No expired run evidence or history to clean up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
