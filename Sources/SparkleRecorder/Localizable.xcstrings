    "No semantic recording link was found for this macro or run; choose a bundle before reviewing frames, OCR, or visual evidence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No semantic recording link was found for this macro or run; choose a bundle before reviewing frames, OCR, or visual evidence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前宏或本次运行没有关联语义录制；请先选择一个记录包，再审阅画面、OCR 或视觉证据。"
          }
        }
      }
    },
    "No workflow mutation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
