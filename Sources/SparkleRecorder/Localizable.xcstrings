    "The selected bundle is not proven to belong to this run, so use it for local review until S2 provides a saved-macro-linked live bundle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected bundle is not proven to belong to this run, so use it for local review until S2 provides a saved-macro-linked live bundle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无法确认所选记录包来自本次运行，因此目前仅用于本地审阅；只有与已保存宏关联的实时记录包才能作为本次运行的证据。"
          }
        }
      }
    },
    "This cancels the current run for \"%@\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cancels the current run for \"%@\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会取消“%@”的当前运行。"
          }
        }
      }
    },
    "This removes \"%@\" from the workflow and removes dependencies attached to it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes \"%@\" from the workflow and removes dependencies attached to it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从工作流中移除“%@”，并移除与它相连的依赖。"
          }
        }
      }
    },
    "This removes task \"%@\" and %d dependent edges from the draft preview. Saved workflows are unchanged until you import.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes task \"%@\" and %d dependent edges from the draft preview. Saved workflows are unchanged until you import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从草稿预览中移除任务“%@”和 %d 条关联连线。导入前，已保存 workflow 不会改变。"
          }
        }
      }
    },
    "This removes the workflow with %d tasks and %d dependencies. Saved macros stay in your macro library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the workflow with %d tasks and %d dependencies. Saved macros stay in your macro library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除包含 %d 个任务和 %d 条依赖的工作流。已保存的宏仍会留在宏库中。"
          }
        }
      }
    },
    "This run does not yet carry a per-run semantic bundle, so review evidence is useful for repair but not accepted as live run proof.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run does not yet carry a per-run semantic bundle, so review evidence is useful for repair but not accepted as live run proof."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次运行尚未绑定独立的语义录制包；这些审阅证据可用于修复，但不能作为本次运行的正式证据。"
          }
        }
      }
    },
    "This starts \"%@\" now and may control the mouse and keyboard while it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This starts \"%@\" now and may control the mouse and keyboard while it runs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会立即启动“%@”，运行期间可能控制鼠标和键盘。"
          }
        }
      }
    },
    "This starts \"%@\" now using its configured automation resources.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This starts \"%@\" now using its configured automation resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会立即启动“%@”，并使用它配置的自动化资源。"
          }
        }
      }
    },
    "This will replace the existing workflow \"%@\" with %d tasks and %d dependencies. It will not run until you start it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will replace the existing workflow \"%@\" with %d tasks and %d dependencies. It will not run until you start it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将现有工作流“%@”替换为包含 %d 个任务和 %d 条依赖的版本。它不会自动运行，直到你手动启动。"
          }
        }
      }
    },
