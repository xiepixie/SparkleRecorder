          "stringUnit": {
            "state": "translated",
            "value": "不修改 workflow"
          }
        }
      }
    },
    "Open a semantic recording bundle for frame timeline, visual evidence, region selection, and review-only draft patch generation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a semantic recording bundle for frame timeline, visual evidence, region selection, and review-only draft patch generation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一个语义录制包，查看画面时间线、视觉证据、选择区域，并生成仅供审阅的草稿补丁。"
          }
        }
      }
    },
    "Opening Macro Review never mutates the workflow; reviewed changes still need Draft Preview and confirmed import.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Macro Review never mutates the workflow; reviewed changes still need Draft Preview and confirmed import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“宏审阅”不会直接修改工作流；审阅后的更改仍需先预览草稿并确认导入。"
          }
        }
      }
    },
    "Press F-key to play %@ from any app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
