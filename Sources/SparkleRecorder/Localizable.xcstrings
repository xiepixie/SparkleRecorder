    "A long delay may be better as a Wait Text condition when the screen changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long delay may be better as a Wait Text condition when the screen changes."
